# Copy to .env for LOCAL development and adjust. Never commit .env or .env.*.
# Hosted settings (Qdrant Cloud, Gemini) go in Render's dashboard, or in a
# separate git-ignored .env.cloud used only with `--env-file .env.cloud`.

PORTFOLIO_AI_APP_NAME="PortfolioAI"
PORTFOLIO_AI_ENVIRONMENT="development"   # development | test | production
PORTFOLIO_AI_LOG_LEVEL="INFO"
PORTFOLIO_AI_LOG_FORMAT="json"           # json | text

# JSON list of browser origins allowed by CORS.
PORTFOLIO_AI_CORS_ORIGINS='["https://irfan512.github.io","http://localhost:3000"]'

# Embeddings: local_http (Docker ONNX embedder, Intel Mac) | onnx (in-process; production image) | sentence_transformers
PORTFOLIO_AI_EMBEDDING_BACKEND="local_http"
PORTFOLIO_AI_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
PORTFOLIO_AI_EMBEDDING_DIMENSION=384
PORTFOLIO_AI_EMBEDDING_SERVICE_URL="http://127.0.0.1:8081"

# Qdrant: local Docker by default. Qdrant Cloud = https URL + API key (keep those in .env.cloud).
PORTFOLIO_AI_QDRANT_URL="http://127.0.0.1:6333"
PORTFOLIO_AI_QDRANT_API_KEY=""
PORTFOLIO_AI_QDRANT_COLLECTION_PREFIX="portfolio_chunks"

# Gemini. Get a key at https://aistudio.google.com/apikey. Requests may cost money.
GEMINI_API_KEY=""
GEMINI_MODEL=""                          # e.g. gemini-3.5-flash-lite (free tier, no billing)
# If answers get cut off on "thinking" models (thinking counts toward the output limit):
# PORTFOLIO_AI_GEMINI_THINKING_LEVEL="low"   # Gemini 3.x
# PORTFOLIO_AI_GEMINI_THINKING_BUDGET=0      # Gemini 2.5

# Retrieval / answering
PORTFOLIO_AI_RETRIEVAL_TOP_K=6
PORTFOLIO_AI_RETRIEVAL_MIN_SCORE=0.30

# Abuse and cost protection
PORTFOLIO_AI_RATE_LIMIT_PER_MINUTE=10
PORTFOLIO_AI_RATE_LIMIT_PER_DAY=100
PORTFOLIO_AI_CHAT_GLOBAL_DAILY_LIMIT=200      # keep below the free-tier daily limit
PORTFOLIO_AI_CHAT_GLOBAL_PER_MINUTE_LIMIT=10  # keep below the free-tier per-minute limit
PORTFOLIO_AI_TRUSTED_PROXY_HOPS=0        # 1 on Render
